% Find the path

best_first(Start, Goal, Path) :-
    best_first_search([Start], Goal, [Start], Path).

best_first_search([Goal | _], Goal, _, [Goal]).

best_first_search([Node | Rest], Goal, Visited, [Node | Path]) :-
    findall(H-Next,
        (edge(Node, Next),
         \+ member(Next, Visited),
         heuristic(Next, H)),
        Children),
    keysort(Children, Sorted),
    pairs_values(Sorted, NextNodes),
    append(NextNodes, Rest, NewOpen),
    best_first_search(NewOpen, Goal,
        [Node | Visited], Path).

