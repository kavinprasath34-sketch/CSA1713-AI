from sklearn.neighbors import KNeighborsClassifier

# Training data
X = [[1, 2], [2, 3], [3, 3], [6, 7], [7, 8]]
y = ['A', 'A', 'A', 'B', 'B']

# Create model
model = KNeighborsClassifier(n_neighbors=3)
model.fit(X, y)

# Prediction
result = model.predict([[2, 2]])

print("Predicted Class:", result[0])
